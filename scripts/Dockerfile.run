# SPDX-License-Identifier: Apache-2.0
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential ca-certificates cmake git m4 pkg-config pre-commit \
        scons python3-dev python3-pydot python3-venv python3-ply python3-psutil \
        zlib1g-dev libprotobuf-dev protobuf-compiler libprotoc-dev \
        libgoogle-perftools-dev libboost-all-dev libhdf5-dev \
        libcapstone-dev libpng-dev libelf-dev libjson-c-dev \
    && rm -rf /var/lib/apt/lists/*
