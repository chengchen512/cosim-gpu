# SPDX-License-Identifier: Apache-2.0
FROM debian:bookworm-slim AS build
ARG JOBS=2
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential ca-certificates git ninja-build pkg-config \
        python3 python3-venv python3-pip libglib2.0-dev libpixman-1-dev \
        libjson-c-dev libcmocka-dev \
    && rm -rf /var/lib/apt/lists/*
COPY qemu /source/qemu
WORKDIR /source/qemu
RUN case "$TARGETARCH" in \
        arm64) qemu_arch=aarch64 ;; \
        amd64) qemu_arch=x86_64 ;; \
        *) exit 1 ;; \
    esac \
    && ./configure --target-list="${qemu_arch}-softmmu" \
        --enable-kvm --enable-vfio-user-server \
        --disable-docs --disable-werror \
    && make -j"${JOBS}" \
    && make install \
    && ln -s "qemu-system-${qemu_arch}" /usr/local/bin/qemu-system-host

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
        libglib2.0-0 libpixman-1-0 libjson-c5 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /usr/local /usr/local
RUN ldconfig
RUN qemu-system-host -machine help | grep 'x-remote' \
    && qemu-system-host -object help | grep 'x-vfio-user-server'
ENTRYPOINT ["/usr/local/bin/qemu-system-host"]
